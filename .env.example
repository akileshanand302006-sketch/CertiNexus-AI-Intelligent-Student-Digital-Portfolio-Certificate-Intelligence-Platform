# CertiNexus AI - Environment Variables
# Copy to .env and fill in values

# Database — MongoDB Atlas
MONGODB_URI=mongodb+srv://akileshanand302006_db_user:<db_password>@certinexuscluster.e5ke8fh.mongodb.net/certinexus?retryWrites=true&w=majority&appName=CertiNexusCluster
MONGODB_DATABASE=certinexus
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Legacy Database (Fallback / SQLite during migration)
DATABASE_URL=sqlite:///./certinexus.db

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-key
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage (local for development)
STORAGE_TYPE=local
STORAGE_PATH=./storage/uploads

# ML Model
MODEL_PATH=./ml/models/production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Classification Confidence Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.80
LOW_CONFIDENCE_THRESHOLD=0.50
